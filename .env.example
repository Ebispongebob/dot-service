# ─── Dot Cloud API ──────────────────────────────────────────────────
# Get your API key from the Dot. App -> More -> API Key
DOT_API_KEY=dot_app_YOUR_API_KEY_HERE

# Default device serial number (optional, can be overridden per-request)
# Get it from Dot. App -> More -> Device list -> Device Serial Number
DOT_DEFAULT_DEVICE_ID=

# Dot API base URL (usually no need to change)
DOT_API_BASE_URL=https://dot.mindreset.tech

# ─── Service Settings ──────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ─── Lark / Feishu Notification Bridge (polling, optional) ─────────
# Requires lark-cli configured and authorized. See README for scopes.
LARK_NOTIFY_ENABLED=false
LARK_NOTIFY_CLI=lark-cli
LARK_NOTIFY_IDENTITY=user
LARK_NOTIFY_PROFILE=
# Comma-separated group chat IDs (oc_xxx) and/or direct-message user IDs (ou_xxx)
LARK_NOTIFY_CHAT_IDS=
LARK_NOTIFY_USER_IDS=
# Optional filters. If both are empty, all messages from configured sources match.
LARK_NOTIFY_KEYWORDS=@我,紧急,P0
LARK_NOTIFY_MENTION_IDS=
LARK_NOTIFY_MONITOR_ALL=true
LARK_NOTIFY_POLL_INTERVAL_SECONDS=60
LARK_NOTIFY_LOOKBACK_MINUTES=10
LARK_NOTIFY_PAGE_SIZE=20
LARK_NOTIFY_SKIP_EXISTING_ON_START=true
LARK_NOTIFY_STATE_FILE=.runtime/lark_notify_state.json
LARK_NOTIFY_DOT_TITLE=飞书通知
LARK_NOTIFY_DOT_SIGNATURE=Lark Bridge
